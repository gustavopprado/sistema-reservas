# ------------------------------------------------------------------
# Modelo de configuração do frontend.
# Copie para `client/.env` e preencha com os valores reais.
# O arquivo `client/.env` NUNCA deve ser commitado.
#
# ATENÇÃO: tudo que começa com VITE_ é embutido no bundle do `npm run build`
# e fica visível para qualquer usuário do site. Isto serve para manter os
# valores fora do repositório público — não é um controle de segurança.
# A autorização real precisa ser validada no backend.
# ------------------------------------------------------------------

# Endereço da API
VITE_API_URL=http://localhost:3000

# ---- Firebase Web SDK ----
# Copie de: Firebase Console > Configurações do projeto > Seus apps > Configuração
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ---- Módulo Salas ----
# Admin que pode editar/cancelar reservas de terceiros
VITE_ROOM_ADMIN_EMAIL=admin@seudominio.com.br
# Admin com acesso ao painel de histórico completo
VITE_ROOM_PANEL_ADMIN_EMAIL=admin@seudominio.com.br
# E-mails autorizados a reservar a sala restrita (separados por vírgula)
VITE_RESTRICTED_ROOM_EMAILS=pessoa1@seudominio.com.br,pessoa2@seudominio.com.br
# IDs dos documentos das salas no Firestore
VITE_RESTRICTED_ROOM_ID=
VITE_SALAO_ROOM_ID=

# ---- Módulo Veículos ----
# Equipe de Suprimentos com acesso ao Painel de Frota (separados por vírgula)
VITE_FLEET_ADMIN_EMAILS=suprimentos@seudominio.com.br
