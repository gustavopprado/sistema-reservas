# ------------------------------------------------------------------
# Modelo de configuração do backend.
# Copie para `api/.env` e preencha com os valores reais.
# O arquivo `api/.env` NUNCA deve ser commitado.
# ------------------------------------------------------------------

# Porta em que a API sobe
PORT=3000

# URL pública do frontend — usada nos links dentro dos e-mails
APP_URL=http://localhost:5173

# ---- Firebase Admin ----
# Caminho do JSON da service account (arquivo fora do versionamento).
# Baixe em: Firebase Console > Configurações do projeto > Contas de serviço
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# ---- Gmail SMTP ----
# Use uma "Senha de app" (App Password), nunca a senha real da conta.
# Gere em: https://myaccount.google.com/apppasswords
GMAIL_USER=exemplo@seudominio.com.br
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM_NAME_ROOMS=Sistema de Reservas
MAIL_FROM_NAME_FLEET=Sistema de Frotas

# Setor que recebe cópia das movimentações de frota
EMAIL_SUPRIMENTOS=suprimentos@seudominio.com.br

# ---- Google Calendar ----
# Agenda compartilhada usada como fallback da Delegação em Todo o Domínio
SHARED_CALENDAR_ID=reservas@seudominio.com.br

# ---- Administração ----
# Admin do módulo de salas
ADMIN_EMAIL=admin@seudominio.com.br
# Admin com acesso ao histórico completo de reservas de sala
ADMIN_BOOKINGS_EMAIL=admin@seudominio.com.br
# Senha do Painel Suprimentos para forçar encerramento de reservas
ADMIN_FINALIZE_PASSWORD=troque-esta-senha
# Equipe de Suprimentos (separados por vírgula). Gerencia os documentos da
# aba Documentos. Use a mesma lista de VITE_FLEET_ADMIN_EMAILS do client/.env.
FLEET_ADMIN_EMAILS=suprimentos@seudominio.com.br

# ---- Diretório do Google Workspace (autocomplete de convidados) ----
# E-mail de um ADMINISTRADOR do Workspace. A Service Account personifica essa
# conta para ler o diretório via Admin SDK. Deixe vazio para desligar a
# integração — o sistema volta a usar client/src/users.json como fallback.
# Exige que os escopos de leitura do Admin SDK estejam autorizados na
# Delegação em Todo o Domínio (ver README).
DIRECTORY_ADMIN_SUBJECT=admin@seudominio.com.br

# Minutos que a lista de pessoas/grupos fica em cache na memória da API
DIRECTORY_CACHE_TTL_MINUTES=15

# Defina como false para não listar os Google Groups da organização
DIRECTORY_INCLUDE_GOOGLE_GROUPS=true

# Contas de robô/serviço que não devem aparecer no autocomplete
DIRECTORY_EXCLUDED_EMAILS=noreply@seudominio.com.br

# ---- Aba Documentos do módulo de veículos (Google Drive) ----
# Conta do Workspace que a Service Account personifica para ler os PDFs.
# Com ela, links com acesso "Qualquer pessoa na organização com o link"
# abrem sem compartilhar nada. Exige o escopo drive.readonly na Delegação em
# Todo o Domínio (ver README). O sistema lê TODO o Drive dessa conta, então
# prefira uma conta de serviço/robô com poucos arquivos pessoais.
# Vazio = a Service Account só lê o que for compartilhado com ela.
DRIVE_SUBJECT=

# ---- Autenticação das rotas de diretório ----
# Domínios cujos usuários podem consultar o diretório pela API.
# Vazio = qualquer conta autenticada no Firebase do projeto.
ALLOWED_EMAIL_DOMAINS=seudominio.com.br

# ---- Sala restrita ----
# ID do documento da sala no Firestore
RESTRICTED_ROOM_ID=
# E-mails autorizados a reservá-la, separados por vírgula
RESTRICTED_ROOM_EMAILS=pessoa1@seudominio.com.br,pessoa2@seudominio.com.br
